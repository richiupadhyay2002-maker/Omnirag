# ============================================================
# OmniRAG environment configuration
# Copy this file to ".env" and edit values. Never commit ".env".
# ============================================================

# ---- LLM Provider: "ollama" (default, 100% free/local) or "groq" (optional free-tier API) ----
LLM_PROVIDER=ollama

# ---- Ollama (local, $0, requires https://ollama.com installed) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llava:7b

# ---- Optional: Groq free-tier API (only used if LLM_PROVIDER=groq) ----
# Get a free key at https://console.groq.com — verify current free-tier limits yourself,
# they change over time. Leave blank if not using.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Embeddings (always local & free — sentence-transformers, no API key needed) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Vector store (local, free, on-disk) ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- File storage ----
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=100

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# ---- OCR (optional, only needed for scanned/image text extraction) ----
# Windows: install Tesseract from https://github.com/UB-Mannheim/tesseract/wiki
# and set the path below if it's not on your system PATH.
TESSERACT_CMD=
